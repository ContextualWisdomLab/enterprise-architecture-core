{
  "openapi": "3.2.0",
  "info": {
    "title": "Enterprise Architecture Core API",
    "version": "0.1.0",
    "description": "Implemented process surface. Call GET /health to confirm the process is up, then GET /ready before sending tenant traffic. Typed domain commands remain a later milestone."
  },
  "servers": [{"url": "https://ea-core.example.invalid"}],
  "security": [{"keyverseBearer": []}],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "security": [],
        "summary": "Confirm the process is alive",
        "description": "Use this probe to confirm the OS process is running. Then call GET /ready before routing tenant traffic.",
        "responses": {
          "200": {
            "description": "Process is alive. Next action: call GET /ready.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/HealthStatus"}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReady",
        "security": [],
        "summary": "Confirm contracts and database dependencies",
        "description": "Use this probe after GET /health. A 503 means keep the instance out of the load-balancer pool until contract and database checks pass.",
        "responses": {
          "200": {
            "description": "Dependencies are ready. Next action: keep the instance in the serving pool.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ReadyStatus"}
              }
            }
          },
          "503": {
            "description": "A required dependency is not ready. Next action: inspect contract_ready and database_ready, then repair that dependency.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ReadyStatus"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "keyverseBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service_name", "status_code"],
        "properties": {
          "service_name": {
            "type": "string",
            "const": "enterprise-architecture-core"
          },
          "status_code": {
            "type": "string",
            "const": "alive"
          }
        }
      },
      "ReadyStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service_name",
          "status_code",
          "contract_ready",
          "database_ready"
        ],
        "properties": {
          "service_name": {
            "type": "string",
            "const": "enterprise-architecture-core"
          },
          "status_code": {
            "type": "string",
            "enum": ["ready", "not_ready"]
          },
          "contract_ready": {"type": "boolean"},
          "database_ready": {"type": "boolean"}
        }
      }
    }
  },
  "x-keyverse-contract": {
    "requiredConfiguration": [
      "EA_OIDC_ISSUER",
      "EA_OIDC_AUDIENCE",
      "EA_OIDC_JWKS_URL",
      "EA_TENANT_CLAIM",
      "EA_ROLE_CLAIM"
    ],
    "requiredChecks": [
      "signature",
      "issuer",
      "audience",
      "expiration",
      "tenant",
      "role"
    ]
  }
}
