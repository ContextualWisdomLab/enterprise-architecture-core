{
  "openapi": "3.2.0",
  "info": {
    "title": "Enterprise Architecture Core API",
    "version": "0.1.0",
    "description": "Foundation service contract. Only the implemented liveness endpoint is advertised until typed, idempotent domain commands are available."
  },
  "servers": [{"url": "https://ea-core.example.invalid"}],
  "security": [{"keyverseBearer": []}],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Service process is alive"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "keyverseBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "x-keyverse-contract": {
    "requiredConfiguration": [
      "EA_OIDC_ISSUER",
      "EA_OIDC_AUDIENCE",
      "EA_OIDC_JWKS_URL",
      "EA_TENANT_CLAIM",
      "EA_ROLE_CLAIM"
    ],
    "requiredChecks": [
      "signature",
      "issuer",
      "audience",
      "expiration",
      "tenant",
      "role"
    ]
  }
}
